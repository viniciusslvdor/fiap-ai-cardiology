    {
        "id": "alert_led",
        "type": "ui-template",
        "z": "cardioia_tab",
        "group": "g_status",
        "page": "",
        "ui": "",
        "name": "Alert indicator (LED)",
        "order": 1,
        "width": "6",
        "height": "3",
        "head": "",
        "format": "<template>\n  <div class=\"cardio-alert\" :class=\"'lvl-' + level\">\n    <div class=\"cardio-led\" :title=\"title\"></div>\n    <div class=\"cardio-body\">\n      <div class=\"cardio-title\">{{ title }}</div>\n      <ul v-if=\"reasons.length\" class=\"cardio-reasons\">\n        <li v-for=\"r in reasons\" :key=\"r\">{{ r }}</li>\n      </ul>\n      <div class=\"cardio-detail\">{{ detail }}</div>\n    </div>\n  </div>\n</template>\n\n<script>\nexport default {\n  computed: {\n    level () { return this.msg?.payload?.level || 'nodata' },\n    reasons () { return this.msg?.payload?.reasons || [] },\n    detail () { return this.msg?.payload?.detail || 'Waiting for the first reading...' },\n    title () {\n      return { alert: 'ALERT', warning: 'Attention', normal: 'Normal', nodata: 'No data' }[this.level]\n    }\n  }\n}\n</script>\n\n<style>\n.cardio-alert { display: flex; gap: 16px; align-items: center; padding: 12px; border-radius: 8px; border: 2px solid #ccc; width: 100%; }\n.cardio-led { flex: none; width: 48px; height: 48px; border-radius: 50%; background: #9e9e9e; }\n.cardio-title { font-size: 1.4rem; font-weight: 700; }\n.cardio-reasons { margin: 4px 0 4px 18px; padding: 0; }\n.cardio-detail { font-size: 0.85rem; opacity: 0.75; }\n.lvl-normal { border-color: #2e7d32; }\n.lvl-normal .cardio-led { background: #43a047; box-shadow: 0 0 12px #43a047; }\n.lvl-warning { border-color: #f9a825; }\n.lvl-warning .cardio-led { background: #fbc02d; box-shadow: 0 0 12px #fbc02d; }\n.lvl-alert { border-color: #c62828; background: rgba(198, 40, 40, 0.06); }\n.lvl-alert .cardio-led { background: #e53935; box-shadow: 0 0 16px #e53935; animation: cardio-blink 0.8s infinite; }\n@keyframes cardio-blink { 50% { opacity: 0.3; } }\n</style>\n",
