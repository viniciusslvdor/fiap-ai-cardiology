    {
        "id": "fog_fn",
        "type": "function",
        "z": "cardioia_tab",
        "name": "Fog: validate + check limits",
        "func": "// Validates the reading, checks the limits and routes values to the widgets\nconst LIMITS = { bpmHigh: 120, bpmWarn: 100, bpmLow: 50, tempHigh: 38.0, tempWarn: 37.5, tempLow: 35.0 };\nconst LIVE_MAX_AGE_S = 10;   // older readings came from the device buffer\n\nconst p = msg.payload;\nif (!p || typeof p !== 'object' || typeof p.bpm !== 'number') {\n    node.warn('Invalid message ignored: ' + JSON.stringify(p));\n    return null;\n}\nif (p.bpm < 20 || p.bpm > 250 || (p.temp_c !== null && (p.temp_c < 25 || p.temp_c > 45))) {\n    node.warn(`Out-of-range reading ignored (seq ${p.seq})`);\n    return null;\n}\n\n// capture time = now - age\nconst ageS = Number.isFinite(p.age_s) && p.age_s >= 0 ? p.age_s : 0;\nconst capturedAt = Date.now() - ageS * 1000;\nconst live = ageS <= LIVE_MAX_AGE_S;\nconst when = new Date(capturedAt).toLocaleTimeString('pt-BR');\n\nconst reasons = [];\nlet level = 'normal';\nconst raise = (lvl, text) => {\n    reasons.push(text);\n    if (lvl === 'alert' || level === 'normal') level = lvl;\n};\nif (p.bpm > LIMITS.bpmHigh) raise('alert', `Tachycardia: ${p.bpm} bpm (> ${LIMITS.bpmHigh})`);\nelse if (p.bpm < LIMITS.bpmLow) raise('alert', `Bradycardia: ${p.bpm} bpm (< ${LIMITS.bpmLow})`);\nelse if (p.bpm > LIMITS.bpmWarn) raise('warning', `Elevated heart rate: ${p.bpm} bpm`);\nif (typeof p.temp_c === 'number') {\n    if (p.temp_c >= LIMITS.tempHigh) raise('alert', `Fever: ${p.temp_c.toFixed(1)} °C (≥ ${LIMITS.tempHigh})`);\n    else if (p.temp_c < LIMITS.tempLow) raise('alert', `Hypothermia: ${p.temp_c.toFixed(1)} °C (< ${LIMITS.tempLow})`);\n    else if (p.temp_c >= LIMITS.tempWarn) raise('warning', `Low-grade fever: ${p.temp_c.toFixed(1)} °C`);\n} else {\n    raise('warning', 'Temperature sensor without reading');\n}\nif (Array.isArray(p.alerts) && p.alerts.includes('FALL')) raise('alert', 'Possible fall detected by the accelerometer');\n\n// charts: every reading, plotted at its capture time\nconst hrPoints = [\n    { topic: 'Heart rate', payload: { x: capturedAt, y: p.bpm } },\n    { topic: `Limit ${LIMITS.bpmHigh} bpm`, payload: { x: capturedAt, y: LIMITS.bpmHigh } }\n];\nconst tempPoint = typeof p.temp_c === 'number'\n    ? [\n        { topic: 'Temperature', payload: { x: capturedAt, y: p.temp_c } },\n        { topic: `Limit ${LIMITS.tempHigh} °C`, payload: { x: capturedAt, y: LIMITS.tempHigh } }\n    ]\n    : null;\n\n// buffered readings only go to the charts\nif (!live) {\n    const note = level === 'alert'\n        ? { payload: `Recorded while offline at ${when} — ${reasons.join('; ')}` }\n        : null;\n    return [hrPoints, tempPoint, null, null, null, note, null];\n}\n\nflow.set('lastLiveAt', Date.now());\n\nconst detail = `${p.patient} · ${when} · ${p.bpm_source === 'button' ? 'pulse from button' : 'pulse simulated (pot)'}`\n    + ` · ${p.moving ? 'moving' : 'still for ' + p.still_s + ' s'}`;\nconst indicator = { payload: { level, reasons, detail } };\n\n// pop-up only when the problems change\nconst key = level === 'alert' ? reasons.map((r) => r.split(':')[0]).join('|') : '';\nlet notify = null;\nif (key && key !== flow.get('lastAlertKey')) {\n    notify = { payload: `${p.patient}: ${reasons.join('; ')}` };\n}\nflow.set('lastAlertKey', key);\n\nconst info = { payload: `#${p.seq} at ${when} · ${p.buffered || 0} waiting on device` };\n\nreturn [\n    hrPoints,\n    tempPoint,\n    { payload: p.bpm },\n    typeof p.temp_c === 'number' ? { payload: p.temp_c } : null,\n    indicator,\n    notify,\n    info\n];",
        "outputs": 7,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 420,
        "y": 180,
        "outputLabels": [
            "heart-rate chart",
            "temperature chart",
            "bpm gauge",
            "temperature gauge",
            "alert indicator",
            "notification",
            "info"
        ],
