    {
        "id": "watchdog_fn",
        "type": "function",
        "z": "cardioia_tab",
        "name": "watchdog: no data for 30 s?",
        "func": "// no live reading for 30 s -> \"no data\"\nconst last = flow.get('lastLiveAt') || 0;\nif (Date.now() - last < 30000) return null;\nif (flow.get('staleShown')) return null;\nflow.set('staleShown', true);\nreturn { payload: { level: 'nodata', reasons: [], detail: 'No live reading in the last 30 s' } };",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 420,
        "y": 400,
        "wires": [
            [
                "alert_led"
            ]
        ]
    },
    {
        "id": "forward_fn",
        "type": "function",
        "z": "cardioia_tab",
        "name": "to REST API (if CARDIOIA_API_URL)",
        "func": "// Forwards readings to the REST API when CARDIOIA_API_URL is set\nconst base = env.get('CARDIOIA_API_URL');\nif (!base) return null;\nconst p = msg.payload;\nconst ageS = Number.isFinite(p.age_s) && p.age_s >= 0 ? p.age_s : 0;\nmsg.url = base.replace(/\\/$/, '') + '/api/vitals';\nmsg.method = 'POST';\nmsg.headers = { 'Content-Type': 'application/json' };\nmsg.payload = {\n    patient_id: p.patient,\n    device_id: p.device,\n    seq: p.seq,\n    captured_at: new Date(Date.now() - ageS * 1000).toISOString(),\n    heart_rate: p.bpm,\n    temperature: p.temp_c,\n    humidity: p.humidity,\n    moving: !!p.moving,\n    still_seconds: p.still_s,\n    source: 'esp32-mqtt'\n};\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 420,
        "y": 560,
        "wires": [
            [
                "http_post"
            ]
        ]
    },
